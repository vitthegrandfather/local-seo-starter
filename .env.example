# Optional public origin, without a path or trailing slash.
# Set your final production URL before the production build, e.g. https://your-project.vercel.app.
# If empty: VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty for no analytics requests.
# NEXT_PUBLIC_* values are public and embedded at build time. Never put secrets here.
NEXT_PUBLIC_GA4_ID=

# Optional Search Console HTML-tag verification token. No GSC property is needed locally.
GOOGLE_SITE_VERIFICATION=

# Default false: all 7 public pages are indexable and included in sitemap.xml.
# Set true for a private demo/preview: adds noindex and returns an empty sitemap.
# Crawling stays allowed so search engines can read noindex. This is not access control.
# Rebuild after changing this or other values used in statically rendered pages.
NEXT_PUBLIC_NOINDEX=false

# Optional HTTPS webhook receiving a JSON contact payload (server-side only).
# Empty = demo mode: validate, log only redacted field-presence/length metadata, return demo success.
# Configure only an endpoint you own; verify its expected JSON format before enabling.
FORM_ENDPOINT=

# Optional bearer token for that webhook, server-side only. Never prefix with NEXT_PUBLIC_.
FORM_ENDPOINT_TOKEN=
